{{ 'nq-floating.css' | asset_url | stylesheet_tag }}

{% if product %}

{% comment %} Derive mode + position class {% endcomment %}
{% assign nq_mode     = block.settings.widget_mode %}
{% assign nq_pos      = block.settings.position %}
{% assign nq_w_desk   = block.settings.widget_size_desktop %}
{% assign nq_w_mob    = block.settings.widget_size_mobile %}

{% comment %} Rectangle aspect ratio for height calculation {% endcomment %}
{% assign nq_h_desk   = nq_w_desk | times: 1.78 | round %}
{% assign nq_h_mob    = nq_w_mob  | times: 1.78 | round %}

{% comment %} Circle: width == height {% endcomment %}
{% if nq_mode == 'circle' %}
  {% assign nq_h_desk = nq_w_desk %}
  {% assign nq_h_mob  = nq_w_mob  %}
{% endif %}

<div
  class="nq-float-wrap nq-mode-{{ nq_mode }} nq-pos-{{ nq_pos }}"
  id="nq-float-{{ block.id }}"
  style="display:none; width:{{ nq_w_desk }}px; height:{{ nq_h_desk }}px;"
  data-w-desk="{{ nq_w_desk }}"
  data-h-desk="{{ nq_h_desk }}"
  data-w-mob="{{ nq_w_mob }}"
  data-h-mob="{{ nq_h_mob }}"
  data-mode="{{ nq_mode }}"
>
  {% if nq_mode == 'circle' %}
    <span class="nq-circle-hint">▼ Watch video</span>
  {% endif %}

  <button class="nq-float-close" id="nq-float-close-{{ block.id }}" aria-label="Close">&#10005;</button>

  <div class="nq-float-video-wrap">
    <video
      class="nq-float-video"
      id="nq-float-video-{{ block.id }}"
      autoplay muted loop playsinline
    ></video>
    <button class="nq-float-mute" id="nq-float-mute-{{ block.id }}" aria-label="Toggle mute">&#128263;</button>
  </div>
</div>

<script>
(function() {
  var shop      = "{{ shop.permanent_domain }}";
  var productId = "{{ product.id }}";
  var blockId   = "{{ block.id }}";
  var API       = "https://claura-shoppable.vercel.app/api/videos";
  var apiURL    = API + "?shop=" + shop + "&product_id=gid://shopify/Product/" + productId;
  var isMuted   = true;
  var manuallyClosed = false;

  var wrap     = document.getElementById("nq-float-" + blockId);
  var videoEl  = document.getElementById("nq-float-video-" + blockId);
  var closeBtn = document.getElementById("nq-float-close-" + blockId);
  var muteBtn  = document.getElementById("nq-float-mute-" + blockId);
  var mode     = wrap ? wrap.dataset.mode : "rectangle";

  /* ── Responsive sizing ── */
  function applySize() {
    if (!wrap) return;
    var isMob = window.innerWidth <= 768;
    var w = isMob ? parseInt(wrap.dataset.wMob) : parseInt(wrap.dataset.wDesk);
    var h = isMob ? parseInt(wrap.dataset.hMob) : parseInt(wrap.dataset.hDesk);
    wrap.style.width  = w + "px";
    wrap.style.height = h + "px";
  }
  applySize();
  window.addEventListener("resize", applySize, { passive: true });

  /* ── Show / hide ── */
  function hideFloat() {
    wrap.classList.remove("nq-float-visible");
    setTimeout(function() { if (!wrap.classList.contains("nq-float-visible")) wrap.style.display = "none"; }, 320);
    videoEl.pause();
  }

  function showFloat() {
    if (manuallyClosed) return;
    if (!videoEl.src) return;
    applySize();
    wrap.style.display = "block";
    setTimeout(function() { wrap.classList.add("nq-float-visible"); }, 60);
    videoEl.play().catch(function(){});
  }

  /* ── Circle click → scroll to carousel ── */
  if (mode === "circle" && wrap) {
    wrap.addEventListener("click", function() {
      /* Find the NQ carousel section on this page */
      var target = document.getElementById("nq-carousel-" + blockId) ||
                   document.querySelector(".nq-section") ||
                   document.querySelector("[id^='nq-carousel-']");
      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        /* Auto-open first video in carousel after scroll */
        setTimeout(function() {
          var firstCard = target.querySelector(".nq-card");
          if (firstCard) firstCard.click();
        }, 700);
      }
    });
  }

  /* ── Fetch & boot ── */
  fetch(apiURL)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var allVideos = data.videos || [];
      var gid = "gid://shopify/Product/" + productId;
      var videos = allVideos.filter(function(v) {
        var ids = Array.isArray(v.product_ids) ? v.product_ids : [];
        return ids.indexOf(gid) >= 0 || ids.indexOf(productId) >= 0;
      });
      if (!videos.length) return;

      var video = videos[0];
      videoEl.src = video.r2_url;
      if (video.thumbnail_url) videoEl.poster = video.thumbnail_url;
      videoEl.muted = true;
      videoEl.play().catch(function(){});

      /* Track view */
      try {
        fetch("https://claura-shoppable.vercel.app/api/track?video_id=" + video.id + "&shop=" + shop + "&event=view", { keepalive: true }).catch(function(){});
      } catch(e) {}

      showFloat();
      setTimeout(watchCartButtons, 800);
    })
    .catch(function() {});

  /* ── Close (rectangle only) ── */
  if (closeBtn) {
    closeBtn.addEventListener("click", function(e) {
      e.stopPropagation();
      manuallyClosed = true;
      hideFloat();
    });
  }

  /* ── Mute (rectangle only) ── */
  if (muteBtn) {
    muteBtn.addEventListener("click", function(e) {
      e.stopPropagation();
      isMuted = !isMuted;
      videoEl.muted = isMuted;
      muteBtn.innerHTML = isMuted ? "&#128263;" : "&#128266;";
    });
  }

  /* ── Watch cart button to auto show/hide ── */
  function watchCartButtons() {
    var selectors = [
      '[name="add"]', '[id*="add-to-cart"]', '[id*="AddToCart"]',
      '.add-to-cart', '.product-form__submit', '#ProductSubmitButton',
      '.btn--add-to-cart', '[data-add-to-cart]',
      'button[type="submit"].product-form__cart-submit'
    ];
    var cartBtn = null;
    for (var i = 0; i < selectors.length; i++) {
      cartBtn = document.querySelector(selectors[i]);
      if (cartBtn) break;
    }
    if (!cartBtn) {
      var buttons = document.querySelectorAll("button, input[type=submit]");
      for (var j = 0; j < buttons.length; j++) {
        var txt = (buttons[j].textContent || buttons[j].value || "").toLowerCase();
        if (txt.includes("add to cart") || txt.includes("buy now") || txt.includes("sold out")) {
          cartBtn = buttons[j]; break;
        }
      }
    }
    if (!cartBtn) return;
    function checkPosition() {
      var rect = cartBtn.getBoundingClientRect();
      if (rect.top > window.innerHeight) { showFloat(); } else { hideFloat(); }
    }
    window.addEventListener("scroll", checkPosition, { passive: true });
    checkPosition();
  }

})();
</script>

{% endif %}

{% schema %}
{
  "name": "NQ Floating Video",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "widget_mode",
      "label": "Widget Style",
      "options": [
        { "value": "rectangle", "label": "Rectangle (portrait video)" },
        { "value": "circle",    "label": "Circle (scroll to carousel on click)" }
      ],
      "default": "rectangle",
      "info": "Circle mode hides close/mute buttons and scrolls to the video carousel when tapped."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left",  "label": "Bottom Left" },
        { "value": "mid-right",    "label": "Middle Right" },
        { "value": "mid-left",     "label": "Middle Left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "range",
      "id": "widget_size_desktop",
      "label": "Size — Desktop (px)",
      "info": "Width for rectangle, diameter for circle",
      "min": 60,
      "max": 280,
      "step": 10,
      "default": 140
    },
    {
      "type": "range",
      "id": "widget_size_mobile",
      "label": "Size — Mobile (px)",
      "info": "Width for rectangle, diameter for circle",
      "min": 50,
      "max": 160,
      "step": 10,
      "default": 80
    }
  ]
}
{% endschema %}